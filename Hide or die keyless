-- NOCLIP
-------------------------------------------------

local Noclip = false

Main:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Flag = "Noclip",

    Callback = function(Value)
        Noclip = Value
    end
})

RunService.Stepped:Connect(function()

    if Noclip then

        local character = LocalPlayer.Character

        if character then

            for _, part in pairs(character:GetDescendants()) do

                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-------------------------------------------------
-- INVISIBLE
-------------------------------------------------

local Invisible = false

local function setInvisible(state)

    local character = LocalPlayer.Character

    if character then

        for _, v in pairs(character:GetDescendants()) do

            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = state and 1 or 0
            end

            if v:IsA("Decal") then
                v.Transparency = state and 1 or 0
            end
        end
    end
end

Main:CreateToggle({
    Name = "Invisible",
    CurrentValue = false,
    Flag = "Invisible",

    Callback = function(Value)

        Invisible = Value
        setInvisible(Invisible)
    end
})

-------------------------------------------------
-- FLY
-------------------------------------------------

local Fly = false
local FlySpeed = 50

Main:CreateSlider({
    Name = "Fly Speed",
    Range = {10, 200},
    Increment = 5,
    Suffix = "Speed",
    CurrentValue = 50,
    Flag = "FlySpeed",

    Callback = function(Value)
        FlySpeed = Value
    end
})

local function toggleFly(state)

    Fly = state

    local character = LocalPlayer.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if Fly then

        if not hrp:FindFirstChild("FluxFly") then

            local BV = Instance.new("BodyVelocity")
            BV.Name = "FluxFly"
            BV.MaxForce = Vector3.new(999999,999999,999999)
            BV.Velocity = Vector3.zero
            BV.Parent = hrp
        end

    else

        local existing = hrp:FindFirstChild("FluxFly")

        if existing then
            existing:Destroy()
        end
    end
end

Main:CreateToggle({
    Name = "Fly",
    CurrentValue = false,
    Flag = "Fly",

    Callback = function(Value)
        toggleFly(Value)
    end
})

RunService.RenderStepped:Connect(function()

    if Fly then

        local character = LocalPlayer.Character
        if not character then return end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local BV = hrp:FindFirstChild("FluxFly")
        if not BV then return end

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += workspace.CurrentCamera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= workspace.CurrentCamera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= workspace.CurrentCamera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += workspace.CurrentCamera.CFrame.RightVector
        end

        BV.Velocity = direction * FlySpeed
    end
end)

-------------------------------------------------
-- AUTO KILL HIDER
-------------------------------------------------

local KillAura = false
local SpamSpeed = 0.05

local SlashRemote = ReplicatedStorage
    :WaitForChild("Network")
    :WaitForChild("knife")
    :WaitForChild("slash")

local function isSeeker()

    return LocalPlayer.Team
    and LocalPlayer.Team.Name == "Seeker"
end

local function isHider(player)

    return player.Team
    and player.Team.Name == "Hider"
end

local function getKnife()

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if character and character:FindFirstChild("Secondary") then
        return character.Secondary
    end

    if backpack and backpack:FindFirstChild("Secondary") then
        return backpack.Secondary
    end

    return nil
end

Main:CreateToggle({
    Name = "Auto Kill Hider",
    CurrentValue = false,
    Flag = "KillAura",

    Callback = function(Value)
        KillAura = Value
    end
})

task.spawn(function()

    while true do

        task.wait(SpamSpeed)

        if not KillAura then
            continue
        end

        if not isSeeker() then
            continue
        end

        local knife = getKnife()

        if not knife then
            continue
        end

        for _, player in pairs(Players:GetPlayers()) do

            if player ~= LocalPlayer
            and isHider(player) then

                local character = player.Character

                if character then

                    local humanoid = character:FindFirstChild("Humanoid")
                    local hrp = character:FindFirstChild("HumanoidRootPart")

                    if humanoid
                    and hrp
                    and humanoid.Health > 0 then

                        local args = {
                            tick(),
                            knife,
                            hrp.CFrame,
                            humanoid
                        }

                        SlashRemote:FireServer(unpack(args))
                    end
                end
            end
        end
    end
end)

